# Neon PostgreSQL Connection Strings
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=your_secure_internal_api_secret_here

# Methodology & Config Versions
NEXT_PUBLIC_ANALYTICS_METHODOLOGY_VERSION=v1.0.0
NEXT_PUBLIC_PARAMETER_CONFIG_VERSION=v1.0.0

# Admin authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"
ADMIN_SESSION_SECRET="your-random-32-character-secret-key"
